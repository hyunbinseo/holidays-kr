{
	"name": "@hyunbinseo/holidays-kr",
	"version": "5.2027.1",
	"description": "South Korea's national holidays, based on the official gazette",
	"keywords": [
		"Korean",
		"holidays",
		"공휴일",
		"대한민국",
		"한국"
	],
	"homepage": "https://github.com/hyunbinseo/holidays-kr#readme",
	"bugs": {
		"url": "https://github.com/hyunbinseo/holidays-kr/issues"
	},
	"license": "MIT",
	"author": "Hyunbin Seo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyunbinseo/holidays-kr.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"imports": {
		"#cli/*": "./cli/*",
		"#src/*": "./src/*"
	},
	"exports": {
		".": "./dist/index.js",
		"./all": "./dist/all.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepack": "tsdown",
		"preversion": "vitest run",
		"version": "node cli/scripts/write/all.ts && git add -A public",
		"postversion": "git push && git push --tags && node cli/scripts/postversion.ts",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "vitest"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@types/node": "^24.13.4",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=18"
	}
}
